/**
 * The design system for {{TITLE}}, generated by `designice scaffold --platform mobile`
 * from the reference "{{REFERENCE_TITLE}}".
 *
 * This is the only place a colour, font, radius or spacing value should be
 * written down. Components read from `theme`; nothing hardcodes a hex. Change a
 * value here and the whole app follows, which is the point of a token system.
 */
// `mode` is typed as the union, not narrowed by `as const`: components branch on
// it (`theme.mode === "dark"`), and a literal type would make the other branch
// a compile error in every app of the opposite mode.
export const theme = {
  mode: "{{COLOR_SCHEME}}" as "light" | "dark",

  colors: {
    ground: "{{COLOR_GROUND}}",
    surface: "{{COLOR_SURFACE}}",
    ink: "{{COLOR_INK}}",
    muted: "{{COLOR_MUTED}}",
    accent: "{{COLOR_ACCENT}}",
    accent2: "{{COLOR_ACCENT2}}",
    // Translucent hairline for raising a surface on a dark ground, where a
    // shadow is invisible and does nothing.
    hairline: "{{HAIRLINE}}",
  },

  // Family names as registered with expo-font in app/_layout.tsx. A font that
  // failed to load falls back to the platform default, never to nothing.
  fonts: {
    display: "{{FONT_DISPLAY_FAMILY}}",
    displayBold: "{{FONT_DISPLAY_BOLD_FAMILY}}",
    body: "{{FONT_BODY_FAMILY}}",
    bodyBold: "{{FONT_BODY_BOLD_FAMILY}}",
  },

  // One type scale, in points. Display sizes are a step below the web scale
  // because a phone is held closer and a 64pt headline reads as shouting.
  type: {
    display: 34,
    h1: 28,
    h2: 22,
    h3: 18,
    body: 16,
    small: 13,
    leadingDisplay: 1.08,
    leadingBody: 1.5,
  },

  spacing: {
    xs: 4,
    sm: 8,
    md: 16,
    lg: 24,
    xl: 32,
    section: 40,
    gutter: 20,
  },

  radius: {
    card: {{RADIUS_PT}},
    pill: 999,
    input: 10,
  },

  // 44pt is Apple's minimum tap target and it is the right floor on Android too.
  tap: 44,
} as const;

export type Theme = typeof theme;
