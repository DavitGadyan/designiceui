@import "tailwindcss";

/*
 * Tokens generated by `designice scaffold` from the reference design
 * "{{REFERENCE_TITLE}}". These are the whole design system - change a value
 * here and it changes everywhere, which is the point. Do not hardcode a colour
 * or a spacing value in a component; add a token instead.
 */
@theme {
  --color-ground: {{COLOR_GROUND}};
  --color-surface: {{COLOR_SURFACE}};
  --color-ink: {{COLOR_INK}};
  --color-muted: {{COLOR_MUTED}};
  --color-accent: {{COLOR_ACCENT}};
  --color-accent2: {{COLOR_ACCENT2}};

  --font-display: {{FONT_DISPLAY_STACK}};
  --font-body: {{FONT_BODY_STACK}};

  --radius-card: {{RADIUS}};

  --spacing-section: {{PAD_DESKTOP}};
  --spacing-section-sm: {{PAD_MOBILE}};
}

:root {
  color-scheme: {{COLOR_SCHEME}};

  --shadow-card: {{SHADOW}};
  --size-display: {{DISPLAY_SIZE}};
  --size-h1: {{H1_SIZE}};
  --size-h2: {{H2_SIZE}};
  --size-body: {{BODY_SIZE}};
  --leading-display: {{LEADING_DISPLAY}};

  /* One easing and one duration family for the whole site. Motion that shares
     a curve reads as one system; motion that doesn't reads as an accident. */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --dur-fast: 180ms;
  --dur-base: 320ms;
  --dur-slow: 600ms;
}

/*
 * Everything below sits inside a @layer on purpose.
 *
 * Tailwind v4 declares `@layer theme, base, components, utilities`, and any
 * unlayered rule outranks every layered one regardless of specificity or source
 * order. Written plainly, `h1 { font-family: ... }` would silently beat
 * `class="font-mono"` on an h1, and `.section-pad` would beat a `py-*` utility
 * passed in through a className prop. Layering these keeps utilities winnable,
 * which is what anyone editing a component will expect.
 */
@layer base {

html {
  -webkit-text-size-adjust: 100%;
}

body {
  background: var(--color-ground);
  color: var(--color-ink);
  font-family: var(--font-body);
  font-size: var(--size-body);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

h1, h2, h3, .display {
  font-family: var(--font-display);
  line-height: var(--leading-display);
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

/* Visible keyboard focus everywhere, not just where someone remembered it.
   Ink, not accent: ink is guaranteed >= 4.5:1 against the ground by the
   token pipeline, while an accent can legitimately sit close to the ground on
   a monochrome palette - and a focus ring nobody can see is worse than none. */
:focus-visible {
  outline: 2px solid var(--color-ink);
  outline-offset: 3px;
  border-radius: 2px;
}

::selection {
  background: var(--color-ink);
  color: var(--color-ground);
}

}

@layer components {

/* Section rhythm. This lives in CSS rather than an inline style because the
   desktop and mobile values differ by breakpoint, and an inline style has no
   media query to hang that on. */
.section-pad {
  padding-block: var(--spacing-section-sm);
}

@media (min-width: 768px) {
  .section-pad {
    padding-block: var(--spacing-section);
  }
}

/* Reveal-on-scroll. The element is laid out from the start and only its paint
   changes, so nothing shifts and the observer never causes a reflow. */
[data-reveal] {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity var(--dur-slow) var(--ease-out),
              transform var(--dur-slow) var(--ease-out);
  transition-delay: var(--reveal-delay, 0ms);
  will-change: opacity, transform;
}

[data-reveal="shown"] {
  opacity: 1;
  transform: none;
}

}

/* Deliberately unlayered so it outranks everything, including utilities.
   Someone who asked their OS to reduce motion has usually asked for a reason.
   Keep opacity so nothing disappears; drop everything that travels. */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  [data-reveal] { opacity: 1; transform: none; }
}
