# --- Embeddings (pick one; designice falls back to the zero-dependency
# lexical backend if neither is set, so the library always works) ---
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Force a backend instead of auto-detecting: voyage | openai | local | lexical
DESIGNICE_EMBED_BACKEND=
DESIGNICE_EMBED_MODEL=

# --- Higgsfield image generation (optional) ---
# Create keys at https://cloud.higgsfield.ai/
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- Library location (defaults to <repo>/docs/designs) ---
DESIGNICE_LIBRARY=
