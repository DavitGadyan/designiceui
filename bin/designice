#!/usr/bin/env python3
"""Launcher for the designice CLI.

Self-locating like bin/designice-mcp: it puts this repo's `src/` on sys.path
by walking up from its own file, so symlinking it into ~/.local/bin gives a
working `designice` command with no pip install and no PYTHONPATH. The library
and output folders are found relative to the repo the same way.
"""

import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "src"))

from designice.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
